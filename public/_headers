/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self'; style-src 'self' 'unsafe-inline'; frame-src 'self'; connect-src 'self' https://anyedits-api.skillmesh.workers.dev https://s3.filebase.io; object-src 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The isolated mermaid frame (sandbox="allow-scripts", NO allow-same-origin)
# runs in an opaque origin, so it fetches these bundled module scripts as a
# cross-origin request. Allow same-site assets to be read by it. These are
# public, non-credentialed static assets, so CORS-allowing them is safe.
/assets/*
  Access-Control-Allow-Origin: *
