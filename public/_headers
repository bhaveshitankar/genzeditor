# NOTE: the main app's Content-Security-Policy is delivered via a <meta> tag in
# index.html (NOT here). Cloudflare Pages _headers APPENDS same-named headers
# across matching rules rather than overriding, so a global `/*` CSP would leak
# into the isolated frames and intersect with their (looser) policy. Keeping the
# main CSP in index.html's <meta> lets each frame below own its CSP cleanly.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# Hashed build output never changes under the same name: cache for a year and
# skip revalidation, so repeat visits make no requests for these files.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/excalidraw-assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate the HTML so new deploys are picked up immediately.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

/favicon.svg
  Cache-Control: public, max-age=604800
/favicon-32.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Isolated mermaid frame: strict policy (no eval of any kind).
/mermaid-frame.html
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self' blob: 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' blob:; worker-src 'self' blob:; object-src 'none'; base-uri 'none'

# The background-removal model (onnxruntime) requires 'unsafe-eval'. Confine that
# to this isolated frame's document instead of the whole app. Served same-origin
# so its bundled script loads under script-src 'self'.
/bg-removal-frame.html
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self' blob: 'wasm-unsafe-eval' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:; connect-src 'self' blob: https://staticimgly.com; object-src 'none'; base-uri 'none'

# The isolated frames (sandbox="allow-scripts", NO allow-same-origin) run in an
# opaque origin, so they fetch these bundled module scripts as a cross-origin
# request. Allow same-site assets to be read by them. These are public,
# non-credentialed static assets, so CORS-allowing them is safe.
/assets/*
  Access-Control-Allow-Origin: *
