/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data: blob:; script-src 'self' blob: 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://esm.sh; style-src 'self' 'unsafe-inline'; media-src 'self' blob:; font-src 'self' data:; frame-src 'self' blob:; worker-src 'self' blob:; connect-src 'self' https://anyedits-api.skillmesh.workers.dev wss://anyedits-api.skillmesh.workers.dev https://s3.filebase.io https://cdn.jsdelivr.net https://esm.sh https://staticimgly.com; object-src 'none'; base-uri 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The isolated mermaid frame (sandbox="allow-scripts", NO allow-same-origin)
# runs in an opaque origin, so it fetches these bundled module scripts as a
# cross-origin request. Allow same-site assets to be read by it. These are
# public, non-credentialed static assets, so CORS-allowing them is safe.
/assets/*
  Access-Control-Allow-Origin: *
