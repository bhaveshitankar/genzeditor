# Vite build-time variables, inlined into the client bundle during `vite build`.
# Committed on purpose: both values are PUBLIC (API base + Turnstile *site* key).
# The Turnstile *secret* key is NOT here — it's a Worker secret.
# Read by the Cloudflare Pages Git build on merge to main.

VITE_API_BASE=https://api.genzeditor.com

# TODO: paste your Turnstile SITE key (Cloudflare dash -> Turnstile -> widget).
# Until this is a real key, the email-OTP step will fail with "turnstile_failed".
VITE_TURNSTILE_SITE_KEY=0x4AAAAAAFNohvdjiQoCCsRM
